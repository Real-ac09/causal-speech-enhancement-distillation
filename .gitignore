!data/external/**/.gitkeep

# Model outputs - ignore generated outputs but keep folders
checkpoints/**
results/**
experiments/**

!checkpoints/**/
!results/**/
!experiments/**/

!checkpoints/**/.gitkeep
!results/**/.gitkeep
!experiments/**/.gitkeep

