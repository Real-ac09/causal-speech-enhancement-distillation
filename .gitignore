*.py[cod]
*.so
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data files - ignore dataset contents but keep folder structure
data/raw/*
data/processed/*
data/interim/*
data/external/*

!data/raw/.gitkeep
!data/raw/**/.gitkeep
!data/processed/.gitkeep
!data/processed/**/.gitkeep
!data/interim/.gitkeep
!data/interim/**/.gitkeep
!data/external/.gitkeep
